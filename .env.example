VITE_SITE_NAME=SecureFix
VITE_SITE_PHONE=020 3336 7147
VITE_SITE_EMAIL=info@securefix.uk

# All booking / quote / chat forms deliver to repair@securefix.uk.
# Live Hostinger path: /api/booking.php → mail(repair@securefix.uk)
# Browser also tries FormSubmit (URL = repair@) and optional Web3Forms (CC repair@).
# VITE_WEB3FORMS_ACCESS_KEY=
# Optional chat-server override for Hostinger booking endpoint:
# SECUREFIX_BOOKING_URL=https://securefix.uk/api/booking.php

# Optional: Groq for smarter AI chat (key starts with gsk_)
# Create a free key at https://console.groq.com/keys
# Without it, Alex still works using the built-in assistant + emails your team.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_API_PORT=3001
