VITE_SITE_NAME=SecureFix
VITE_SITE_PHONE=020 3336 7147
VITE_SITE_EMAIL=info@securefix.uk

# Web3Forms — emails booking, trade-in, and chat enquiries
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional: Groq for smarter AI chat (key starts with gsk_)
# Create a free key at https://console.groq.com/keys
# Without it, Alex still works using the built-in assistant + emails your team.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_API_PORT=3001
