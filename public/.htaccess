RewriteEngine On
DirectorySlash Off
DirectoryIndex index.html

# http and https www → https://securefix.uk (path and query kept)
RewriteCond %{HTTP_HOST} ^www\.securefix\.uk$ [NC]
RewriteRule ^ https://securefix.uk%{REQUEST_URI} [R=301,L]

RewriteRule ^book-call-out/?$ https://securefix.uk/call-out [R=301,L]

# Drop a trailing slash so the canonical path is the one without it.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://securefix.uk/%1 [R=301,L,QSA]

# Prerendered routes are directories with index.html. Serve that file.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Unknown paths: real 404, not the homepage.
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>
