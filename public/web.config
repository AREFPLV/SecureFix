<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.securefix\.uk$" />
          </conditions>
          <action type="Redirect" url="https://securefix.uk/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="book call-out alias" stopProcessing="true">
          <match url="^book-call-out/?$" />
          <action type="Redirect" url="https://securefix.uk/call-out" redirectType="Permanent" />
        </rule>
        <rule name="iphone 14 pro screen" stopProcessing="true">
          <match url="^repair/smartphone/apple-phone/iphone-14-pro/premium-screen-replacement/?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/apple-phone/iphone-14-pro/new-screen-replacement-oled-compatible-most-popular-premium-quality" redirectType="Permanent" />
        </rule>
        <rule name="iphone 14 pro battery" stopProcessing="true">
          <match url="^repair/smartphone/apple-phone/iphone-14-pro/battery-replacement/?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/apple-phone/iphone-14-pro/battery-replacement-apple-original-or-oem-quality" redirectType="Permanent" />
        </rule>
        <rule name="iphone 14 pro charging" stopProcessing="true">
          <match url="^repair/smartphone/apple-phone/iphone-14-pro/charging-unit-repair/?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/apple-phone/iphone-14-pro/not-charging-or-charging-port-repair-dock-replacement" redirectType="Permanent" />
        </rule>
        <rule name="pixel 8 back glass" stopProcessing="true">
          <match url="^repair/smartphone/google/pixel-8/back-glass-replacement/?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/google/google-pixel-8/back-cover-replacement" redirectType="Permanent" />
        </rule>
        <rule name="pixel 8 model" stopProcessing="true">
          <match url="^repair/smartphone/google/pixel-8(/.*)?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/google/google-pixel-8" redirectType="Permanent" />
        </rule>
        <rule name="galaxy s24 ultra" stopProcessing="true">
          <match url="^repair/smartphone/samsung-phone/galaxy-s24-ultra(/.*)?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/samsung-phone" redirectType="Permanent" />
        </rule>
        <rule name="galaxy s24" stopProcessing="true">
          <match url="^repair/smartphone/samsung-phone/galaxy-s24(/.*)?$" />
          <action type="Redirect" url="https://securefix.uk/repair/smartphone/samsung-phone" redirectType="Permanent" />
        </rule>
        <rule name="macbook pro 14" stopProcessing="true">
          <match url="^repair/pc-laptop/apple-mac/macbook-pro-14(/.*)?$" />
          <action type="Redirect" url="https://securefix.uk/repair/pc-laptop/apple-mac" redirectType="Permanent" />
        </rule>
        <rule name="ipad 10th" stopProcessing="true">
          <match url="^repair/tablet-ipad/apple-ipad/ipad-10th(/.*)?$" />
          <action type="Redirect" url="https://securefix.uk/repair/tablet-ipad/apple-ipad" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
