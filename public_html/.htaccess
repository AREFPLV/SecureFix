<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www.securefix.uk -> https://securefix.uk
  RewriteCond %{HTTP_HOST} ^www\.securefix\.uk$ [NC]
  RewriteRule ^ https://securefix.uk%{REQUEST_URI} [R=301,L]

  # Don't rewrite API calls — these need the Node chat server
  RewriteRule ^api/ - [L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
