        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="Redirect www to https://securefix.uk" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.securefix\.uk$" />
          </conditions>
          <action type="Redirect" url="https://securefix.uk/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Skip API" stopProcessing="true">
          <match url="^api/.*" />
          <action type="None" />
        </rule>
        <rule name="Known app routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{SpaRoutes:{URL}}" pattern="^index\.html$" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
